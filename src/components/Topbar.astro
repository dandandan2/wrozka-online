---
const { user } = Astro.locals;
---

<div
  class="mx-auto mb-4 w-full max-w-6xl rounded-xl border border-white/10 bg-white/5 text-sm text-white/80 backdrop-blur-xl"
>
  <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 px-4 py-3">
    <a href="/" class="group flex min-w-0 items-center gap-2 sm:gap-2.5">
      <span
        class="flex size-7 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/5 transition-colors group-hover:border-white/20 sm:size-8"
      >
        <svg viewBox="0 0 24 24" fill="none" class="size-4 sm:size-4.5">
          <defs>
            <linearGradient id="logomark" x1="2" y1="4" x2="20" y2="20" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#c4b5fd"></stop>
              <stop offset="100%" stop-color="#93c5fd"></stop>
            </linearGradient>
          </defs>
          <path
            d="M14.5 3a7.5 7.5 0 1 0 6.5 11.2A9 9 0 0 1 14.5 3z"
            fill="url(#logomark)"
            stroke="url(#logomark)"
            stroke-width="0.5"
            stroke-linejoin="round"></path>
          <path d="M18 3.4l.55 1.3L19.85 5.25l-1.3.55L18 7.1l-.55-1.3-1.3-.55 1.3-.55L18 3.4z" fill="#e9d5ff"></path>
        </svg>
      </span>
      <span
        class="font-display truncate text-lg leading-none font-semibold tracking-wide text-purple-100 transition-colors group-hover:text-white sm:text-xl lg:text-2xl"
      >
        Wróżbita Online
      </span>
    </a>
    {
      user ? (
        <>
          <nav class="hidden items-center gap-2 sm:flex">
            <a
              href="/dashboard"
              class="rounded-lg bg-purple-600 px-3 py-1.5 font-medium text-white transition-colors hover:bg-purple-500"
            >
              Zapytaj wróżkę
            </a>
            <a
              href="/dashboard/profile"
              class="rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-white/80 transition-colors hover:bg-white/10 hover:text-white"
            >
              Twój profil
            </a>
            <a
              href="/dashboard/history"
              class="rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-white/80 transition-colors hover:bg-white/10 hover:text-white"
            >
              Historia
            </a>
            <form method="POST" action="/api/auth/signout">
              <button
                type="submit"
                class="rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-white/80 transition-colors hover:bg-white/10 hover:text-white"
              >
                Wyloguj
              </button>
            </form>
          </nav>

          <button
            type="button"
            id="topbar-menu-button"
            aria-expanded="false"
            aria-controls="topbar-menu"
            class="flex size-9 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-white/80 transition-colors hover:bg-white/10 sm:hidden"
          >
            <svg
              id="topbar-menu-icon-open"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              class="size-5"
            >
              <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg
              id="topbar-menu-icon-close"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              class="hidden size-5"
            >
              <path d="M6 6l12 12M18 6L6 18" />
            </svg>
            <span class="sr-only">Menu</span>
          </button>
        </>
      ) : (
        <a href="/auth/signin" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          Zaloguj się
        </a>
      )
    }
  </div>

  {
    user && (
      <nav id="topbar-menu" class="hidden flex-col gap-2 border-t border-white/10 px-4 py-3 sm:hidden">
        <a
          href="/dashboard"
          class="rounded-lg bg-purple-600 px-3 py-2 text-center font-medium text-white transition-colors hover:bg-purple-500"
        >
          Zapytaj wróżkę
        </a>
        <a
          href="/dashboard/profile"
          class="rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-center text-white/80 transition-colors hover:bg-white/10 hover:text-white"
        >
          Twój profil
        </a>
        <a
          href="/dashboard/history"
          class="rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-center text-white/80 transition-colors hover:bg-white/10 hover:text-white"
        >
          Historia
        </a>
        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            class="w-full rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-white/80 transition-colors hover:bg-white/10 hover:text-white"
          >
            Wyloguj
          </button>
        </form>
      </nav>
    )
  }
</div>

<script>
  const button = document.getElementById("topbar-menu-button");
  const menu = document.getElementById("topbar-menu");
  const iconOpen = document.getElementById("topbar-menu-icon-open");
  const iconClose = document.getElementById("topbar-menu-icon-close");

  button?.addEventListener("click", () => {
    const isHidden = menu?.classList.toggle("hidden");
    menu?.classList.toggle("flex", !isHidden);
    button.setAttribute("aria-expanded", String(!isHidden));
    iconOpen?.classList.toggle("hidden", !isHidden);
    iconClose?.classList.toggle("hidden", isHidden);
  });
</script>
