---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import HistoryItem from "@/components/dashboard/HistoryItem";
import { ServerError } from "@/components/auth/ServerError";
import { createClient } from "@/lib/supabase";

interface HistoryRow {
  id: string;
  question: string;
  answer: string;
  liked: boolean;
  created_at: string;
}

const { user } = Astro.locals;
const error = Astro.url.searchParams.get("error");

const supabase = createClient(Astro.request.headers, Astro.cookies);
const history: HistoryRow[] =
  supabase && user
    ? ((
        await supabase
          .from("fairy_responses")
          .select("id, question, answer, liked, created_at")
          .eq("user_id", user.id)
          .order("created_at", { ascending: false })
      ).data ?? [])
    : [];
---

<Layout title="Historia">
  <div class="bg-cosmic relative min-h-screen w-full overflow-hidden">
    <div
      class="pointer-events-none absolute top-0 -left-24 h-[300px] w-[300px] rounded-full bg-[#c9a668]/15 blur-[120px]"
    >
    </div>

    <div class="relative z-10 flex min-h-screen flex-col p-4">
      <Topbar />
      <div class="mx-auto w-full max-w-3xl flex-1 py-10 text-[#f0e4c8]">
        <div class="mb-6 flex items-center justify-between">
          <h1 class="font-display text-gilded text-2xl font-medium">Historia</h1>
          <a
            href="/dashboard"
            class="rounded-full border border-[#d9b877]/15 bg-white/[0.03] px-3 py-1.5 text-sm text-[#e9ddc4]/75 transition-colors hover:border-[#d9b877]/30 hover:text-[#f4e8cc]"
          >
            Wróć do panelu
          </a>
        </div>

        <ServerError message={error} client:load />

        {
          history.length > 0 && (
            <p class="mt-4 flex items-center gap-2 rounded-full border border-[#d9b877]/15 bg-white/[0.03] px-3 py-2 text-xs text-[#e9ddc4]/50">
              To rozrywka, nie porada. Nie zastępuje profesjonalnej pomocy medycznej, finansowej ani prawnej.
            </p>
          )
        }

        {
          history.length === 0 ? (
            <div class="mt-6 rounded-[2rem] border border-[#d9b877]/15 bg-white/[0.03] p-8 text-center shadow-[inset_0_1px_1px_rgba(244,232,204,0.06)] backdrop-blur-2xl">
              <p class="text-[#e9ddc4]/75">Nie masz jeszcze żadnej historii.</p>
              <a
                href="/dashboard"
                class="mt-4 inline-block rounded-full bg-gradient-to-b from-[#e8cf9c] to-[#c9a668] px-5 py-2 font-medium text-[#1c1408] transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:brightness-105 active:scale-[0.98]"
              >
                Zapytaj wróżkę
              </a>
            </div>
          ) : (
            <div class="mt-4 space-y-4">
              {history.map((entry) => (
                <HistoryItem
                  id={entry.id}
                  question={entry.question}
                  answer={entry.answer}
                  liked={entry.liked}
                  createdAt={entry.created_at}
                  client:load
                />
              ))}
            </div>
          )
        }
      </div>
    </div>
  </div>
</Layout>
