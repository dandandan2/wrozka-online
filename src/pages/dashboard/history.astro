---
import Layout from "@/layouts/Layout.astro";
import HistoryItem from "@/components/dashboard/HistoryItem";
import { ServerError } from "@/components/auth/ServerError";
import { createClient } from "@/lib/supabase";

interface HistoryRow {
  id: string;
  question: string;
  answer: string;
  liked: boolean;
  created_at: string;
}

const { user } = Astro.locals;
const error = Astro.url.searchParams.get("error");

const supabase = createClient(Astro.request.headers, Astro.cookies);
const history: HistoryRow[] =
  supabase && user
    ? ((
        await supabase
          .from("fairy_responses")
          .select("id, question, answer, liked, created_at")
          .eq("user_id", user.id)
          .order("created_at", { ascending: false })
      ).data ?? [])
    : [];
---

<Layout title="Historia">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-lg rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1
        class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent"
      >
        Historia
      </h1>

      <ServerError message={error} client:load />

      {
        history.length > 0 && (
          <p class="mt-4 flex items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-xs text-blue-100/60">
            To rozrywka, nie porada — nie zastępuje profesjonalnej pomocy medycznej, finansowej ani prawnej.
          </p>
        )
      }

      {
        history.length === 0 ? (
          <div class="mt-6 rounded-xl border border-white/10 bg-white/5 p-6 text-center">
            <p class="text-blue-100/80">Nie masz jeszcze żadnej historii.</p>
            <a
              href="/dashboard"
              class="mt-4 inline-block rounded-lg bg-purple-600 px-4 py-2 font-medium text-white transition-colors hover:bg-purple-500"
            >
              Zapytaj wróżkę
            </a>
          </div>
        ) : (
          <div class="mt-4 space-y-4">
            {history.map((entry) => (
              <HistoryItem
                id={entry.id}
                question={entry.question}
                answer={entry.answer}
                liked={entry.liked}
                createdAt={entry.created_at}
                client:load
              />
            ))}
          </div>
        )
      }

      <a href="/dashboard" class="mt-6 block text-center text-sm text-blue-100/60 hover:underline">
        Back to dashboard
      </a>
    </div>
  </div>
</Layout>
