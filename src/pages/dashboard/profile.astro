---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import ProfileForm from "@/components/dashboard/ProfileForm";
import { createClient } from "@/lib/supabase";

interface ProfileRow {
  name: string | null;
  birth_date: string | null;
  about_me: string | null;
}

const { user } = Astro.locals;
const error = Astro.url.searchParams.get("error");
const successMessage = Astro.url.searchParams.get("success") ? "Zapisano zmiany." : null;

// This page is under the `/dashboard` prefix, which middleware.ts already
// guards — a request only reaches here with a configured Supabase client
// and an authenticated user, but the types don't know that, so this stays
// a narrowed expression rather than a non-null assertion.
const supabase = createClient(Astro.request.headers, Astro.cookies);
const profile: ProfileRow | null =
  supabase && user
    ? (await supabase.from("profiles").select("name, birth_date, about_me").eq("id", user.id).single()).data
    : null;
---

<Layout title="Twój profil">
  <div class="bg-cosmic flex min-h-screen flex-col p-4">
    <Topbar />
    <div class="flex flex-1 items-center justify-center">
      <div
        class="w-full max-w-sm rounded-[2rem] border border-[#d9b877]/15 bg-white/[0.03] p-2 shadow-[0_20px_60px_-20px_rgba(0,0,0,0.6)] backdrop-blur-2xl"
      >
        <div
          class="rounded-[calc(2rem-0.5rem)] bg-gradient-to-b from-white/[0.03] to-transparent px-6 py-8 text-[#f0e4c8] shadow-[inset_0_1px_1px_rgba(244,232,204,0.06)]"
        >
          <h1 class="font-display text-gilded mb-6 text-center text-3xl font-medium">Twój profil</h1>
          <ProfileForm
            initialName={profile?.name ?? null}
            initialBirthDate={profile?.birth_date ?? null}
            initialAboutMe={profile?.about_me ?? null}
            serverError={error}
            successMessage={successMessage}
            client:load
          />
          <a
            href="/dashboard"
            class="mt-4 block rounded-full border border-[#d9b877]/15 bg-white/[0.02] px-3 py-1.5 text-center text-sm text-[#e9ddc4]/75 transition-colors hover:border-[#d9b877]/30 hover:text-[#f4e8cc]"
          >
            Wróć do panelu
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
