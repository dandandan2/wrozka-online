---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import AskForm from "@/components/dashboard/AskForm";
import AnswerCard from "@/components/dashboard/AnswerCard";
import { createClient } from "@/lib/supabase";

interface ProfileRow {
  name: string | null;
  birth_date: string | null;
}

interface FairyResponseRow {
  id: string;
  question: string;
  answer: string;
  liked: boolean;
}

const { user } = Astro.locals;
const error = Astro.url.searchParams.get("error");
const responseId = Astro.url.searchParams.get("response");

const supabase = createClient(Astro.request.headers, Astro.cookies);

const profile: ProfileRow | null =
  supabase && user
    ? (await supabase.from("profiles").select("name, birth_date").eq("id", user.id).single()).data
    : null;

const hasCompleteProfile = Boolean(profile?.name && profile.birth_date);

const latestResponse: FairyResponseRow | null =
  supabase && responseId && user
    ? (
        await supabase
          .from("fairy_responses")
          .select("id, question, answer, liked")
          .eq("id", responseId)
          .eq("user_id", user.id)
          .single()
      ).data
    : null;
---

<Layout title="Panel">
  <div class="bg-cosmic relative min-h-screen w-full overflow-hidden">
    <div
      class="pointer-events-none absolute top-0 -right-24 h-[300px] w-[300px] rounded-full bg-purple-500/15 blur-[120px]"
    >
    </div>
    <div
      class="pointer-events-none absolute bottom-0 -left-24 h-[260px] w-[260px] rounded-full bg-blue-500/10 blur-[110px]"
    >
    </div>

    <div class="relative z-10 flex min-h-screen flex-col p-4">
      <Topbar />
      <div class="mx-auto w-full max-w-lg flex-1 py-10">
        <div class="mb-8 text-center sm:text-left">
          <h1
            class="font-display bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent"
          >
            Panel
          </h1>
          <p class="mt-1 text-blue-100/70">
            Witaj, <span class="font-semibold text-white">{user?.email}</span>
          </p>
        </div>

        {
          !hasCompleteProfile ? (
            <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center backdrop-blur-xl">
              <p class="text-blue-100/80">Zanim zapytasz wróżkę, uzupełnij swój profil.</p>
              <a
                href="/dashboard/profile"
                class="mt-4 inline-block rounded-lg bg-purple-600 px-4 py-2 font-medium text-white transition-colors hover:bg-purple-500"
              >
                Uzupełnij profil
              </a>
            </div>
          ) : (
            <div class="rounded-2xl border border-white/10 bg-white/10 p-8 backdrop-blur-xl">
              <AskForm serverError={error} client:load />
              {latestResponse && (
                <AnswerCard
                  id={latestResponse.id}
                  question={latestResponse.question}
                  answer={latestResponse.answer}
                  liked={latestResponse.liked}
                  client:load
                />
              )}
            </div>
          )
        }
      </div>
    </div>
  </div>
</Layout>
