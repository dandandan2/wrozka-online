---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import CodeVerifyForm from "@/components/auth/CodeVerifyForm";
import { MailCheck } from "lucide-react";

const email = Astro.url.searchParams.get("email") ?? "";
const error = Astro.url.searchParams.get("error");
---

<Layout title="Sprawdź skrzynkę e-mail">
  <div class="bg-cosmic flex min-h-screen flex-col p-4">
    <Topbar />
    <div class="flex flex-1 items-center justify-center">
      <div
        class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
      >
        <div
          class="mx-auto mb-4 flex size-14 items-center justify-center rounded-full border border-white/10 bg-white/5 text-purple-300"
        >
          <MailCheck className="size-6" />
        </div>
        <h1
          class="font-display mb-3 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent"
        >
          Sprawdź skrzynkę e-mail
        </h1>
        <p class="mb-6 text-blue-100/80">
          Wysłaliśmy link logujący i 6-cyfrowy kod na adres <span class="font-semibold text-white">{email}</span>.
          Kliknij link albo wpisz kod poniżej.
        </p>

        <div class="text-left">
          <CodeVerifyForm email={email} serverError={error} client:load />
        </div>

        <form method="POST" action="/api/auth/request-link" class="mt-4">
          <input type="hidden" name="email" value={email} />
          <button type="submit" class="text-sm text-purple-300 hover:underline"> Nie dostałeś? Wyślij ponownie </button>
        </form>

        <a href="/auth/signin" class="mt-2 block text-sm text-blue-100/60 hover:underline">Wróć do logowania</a>
      </div>
    </div>
  </div>
</Layout>
